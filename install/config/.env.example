# Installation Configuration Template
# Copy to config/.env and customize

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET_ID=fincrime_er
BQ_LOCATION=US
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Environment
ENVIRONMENT=dev

# Installation Options
AUTO_SETUP_BIGQUERY=false
CREATE_VENV=true
INSTALL_DEPS=true
